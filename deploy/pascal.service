[Unit]
Description=Pascal Discord ban synchronization bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pascal
Group=pascal
WorkingDirectory=/opt/pascal/current
ExecStart=/opt/node24/bin/node --env-file=/opt/pascal/shared/.env --import tsx src/index.ts
Environment=NODE_ENV=production
Environment=PGLITE_SOCKET_PATH=/opt/pascal/shared/pglite.sock
Environment=PATH=/opt/node24/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/pascal/shared

[Install]
WantedBy=multi-user.target
